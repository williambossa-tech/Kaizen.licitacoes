# Copie para .env.local em desenvolvimento. Em produção, configure no Railway (serviço kaizen-b2g-web › Variables).
DATABASE_URL=postgres://usuario:senha@host:6543/postgres   # Supabase › Transaction pooler (produção: usuário kb_app)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                              # chave anon/publishable
SUPABASE_SERVICE_ROLE_KEY=                                  # chave service_role/secret (somente no servidor)
ADMIN_INITIAL_PASSWORD=                                     # senha inicial do administrador (William); troque após o primeiro acesso
OPENAI_API_KEY=                                             # opcional: minutas com IA (Responses API)
OPENAI_MODEL=gpt-5                                          # modelo configurável
DEMO_MODE=1                                                 # permite ao administrador atuar como perfis de demonstração (auditado)
SEED_DEMO=1                                                 # carrega os dados fictícios quando o banco está vazio
# Somente desenvolvimento local, sem Supabase Auth:
# AUTH_MODE=dev
# STORAGE_DIR=.data/arquivos
